{
	"name": "juno",
	"productName": "Juno",
	"description": "A local-first back office for a small business",
	"author": {
		"name": "Nathan Perron"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ntnthefirst/Juno.git"
	},
	"version": "0.1.1",
	"private": true,
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:clean": "node scripts/dev.mjs --clean",
		"dev:renderer": "vite",
		"dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
		"build": "node scripts/build.mjs",
		"build:win": "node scripts/build.mjs --win",
		"build:mac": "node scripts/build.mjs --mac",
		"build:linux": "node scripts/build.mjs --linux",
		"build:main": "tsc -p tsconfig.main.json && node scripts/after-main.mjs",
		"compile": "npm run build:main && vite build",
		"check": "npm run lint && npm run typecheck && npm run test",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.main.json --noEmit",
		"test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
		"test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
		"smoke": "npm run compile && node scripts/smoke.mjs",
		"start": "npm run compile && electron .",
		"icons": "electron scripts/make-icon.mjs && electron scripts/make-installer-art.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.mjs"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@fontsource/inter": "^5.2.5",
		"@fontsource/jetbrains-mono": "^5.2.5",
		"@heroicons/react": "^2.2.0",
		"@lezer/highlight": "^1.2.3",
		"@lezer/markdown": "^1.7.2",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"drizzle-orm": "^0.44.2",
		"electron-updater": "^6.8.3",
		"html-to-text": "^10.0.1",
		"ical.js": "^2.2.1",
		"imapflow": "^2.0.5",
		"mailparser": "^3.9.28",
		"markdown-to-jsx": "^9.10.3",
		"nodemailer": "^10.0.10",
		"pdf-lib": "^1.17.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"rrule": "^2.8.1",
		"sanitize-html": "^2.17.7",
		"uuid": "^11.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/html-to-text": "^9.0.4",
		"@types/mailparser": "^3.4.6",
		"@types/node": "^24.12.0",
		"@types/nodemailer": "^8.0.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/sanitize-html": "^2.16.1",
		"@vitejs/plugin-react": "^6.0.1",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.1",
		"electron": "^41.0.3",
		"electron-builder": "^26.8.1",
		"eslint": "^9.39.4",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.4.0",
		"tailwindcss": "^4.2.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^8.0.1",
		"vitest": "^3.2.7"
	}
}
