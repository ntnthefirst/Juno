{
	"name": "bureau",
	"productName": "Bureau",
	"description": "A local-first back office for a small business",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "npm run build:main && concurrently -k -n vite,main,electron -c cyan,yellow,magenta \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
		"dev:renderer": "vite",
		"dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
		"dev:electron": "wait-on tcp:5173 dist-electron/main.js && cross-env BUREAU_DEV=1 electron .",
		"build:main": "tsc -p tsconfig.main.json && node scripts/after-main.mjs",
		"build": "npm run typecheck && npm run build:main && vite build",
		"start": "npm run build && electron .",
		"dist": "npm run build && electron-builder --publish never",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.main.json --noEmit",
		"test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
		"test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
		"smoke": "npm run build && node scripts/smoke.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.mjs"
	},
	"dependencies": {
		"@fontsource/inter": "^5.2.5",
		"@fontsource/jetbrains-mono": "^5.2.5",
		"drizzle-orm": "^0.44.2",
		"electron-updater": "^6.8.3",
		"html-to-text": "^10.0.1",
		"imapflow": "^2.0.5",
		"mailparser": "^3.9.28",
		"nodemailer": "^10.0.10",
		"pdf-lib": "^1.17.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sanitize-html": "^2.17.7",
		"uuid": "^11.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/html-to-text": "^9.0.4",
		"@types/mailparser": "^3.4.6",
		"@types/node": "^24.12.0",
		"@types/nodemailer": "^8.0.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/sanitize-html": "^2.16.1",
		"@vitejs/plugin-react": "^6.0.1",
		"concurrently": "^9.2.1",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.1",
		"electron": "^41.0.3",
		"electron-builder": "^26.8.1",
		"eslint": "^9.39.4",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.4.0",
		"tailwindcss": "^4.2.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^8.0.1",
		"vitest": "^3.2.7",
		"wait-on": "^9.0.4"
	}
}
