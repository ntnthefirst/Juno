{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"skipLibCheck": true,

		// CommonJS on purpose. The repo is "type": "module", so the build writes a
		// dist-electron/package.json declaring commonjs (see scripts/build-main.mjs).
		// ESM output would force explicit .js extensions on every relative import,
		// which buys nothing here.
		"module": "CommonJS",
		"moduleResolution": "Node",
		"esModuleInterop": true,
		"resolveJsonModule": true,

		"outDir": "dist-electron",
		"rootDir": "electron",
		"noEmit": false,
		"sourceMap": true,

		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,

		"types": ["node"],
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.main.tsbuildinfo"
	},
	"include": ["electron"]
}
